# Example Environment Configuration
# Copy this file to .env.development or .env.production and fill in your values
# NEVER commit real credentials to git!

NODE_ENV=development

# Server
PORT=3050
API_URL=http://localhost:3050
FRONTEND_URL=http://localhost:3050
PUBLIC_SITE_URL=http://localhost:3050

# Database
# For production with auth: mongodb://username:password@host:port/dbname?authSource=admin
MONGODB_URL=mongodb://localhost:27017/soccer

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# Swagger Documentation (true/false - always enabled in development)
ENABLE_SWAGGER=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120

# CORS (use * for development, specific origins for production)
CORS_ORIGINS=*

# Listener (listener/index.js): mengisi MongoDB dari football-data.org
# Jalankan terpisah dari API: npm run listener
FOOTBALL_DATA_TOKEN=
# Daftar slug liga, dipisah koma (default: semua liga di listener/leagues.js)
LISTENER_LEAGUES=eng.1,esp.1
# Interval polling (milidetik)
LISTENER_SCOREBOARD_MS=60000
LISTENER_DETAILS_MS=60000
LISTENER_STANDINGS_MS=1800000
LISTENER_CATALOG_MS=21600000
# Jarak minimum antar request ke football-data.org (tier gratis sekitar 10 request/menit)
FOOTBALL_DATA_MIN_INTERVAL_MS=6500
